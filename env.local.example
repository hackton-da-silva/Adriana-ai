# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional visual annotation by voice. The origin is the public HTTPS URL of this Next.js process.
OPENAI_API_KEY=
AGORA_ANNOTATION_ORIGIN=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Optional private RAG source. UTF-8 Markdown or text, outside public/.
# RAG_DOCUMENT_PATH=.rag/document.md
# RAG_DOCUMENT_TITLE=Manual de manutenção
# OPENAI_RAG_MODEL=gpt-5.4-mini
# RAG_DOCUMENT_LANGUAGE=inglês

# Optional: local Langfuse trace export
# LANGFUSE_BASE_URL=http://127.0.0.1:3100
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

FEITA_API_KEY=

# Ativa os dois MCPs Python da planta simulada junto com AGORA_ANNOTATION_ORIGIN.
PLANTA_MCP_TOKEN=

# Optional post-call analysis. Reuses OPENAI_API_KEY and/or FEITA_API_KEY.
# OPENAI_POSTMORTEM_MODEL=gpt-5.4-mini
